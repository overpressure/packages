#!/bin/bash
# SPDX-License-Identifier: Unlicense
# Start a DSP through remoteproc: PICO OS's images (slpi.mdt, cdsp.mdt, adsp.mdt) are in
# /usr/lib/firmware, where the kernel looks. After a crash mainline restarts only that DSP (its
# recovery, on by default), as restart level RELATED does on PICO OS.
#
#   remoteproc-boot NAME [TIMEOUT]
. /usr/libexec/pico4/lib.sh
set -u
name=$1

rproc=
for r in /sys/class/remoteproc/*; do
	[ "$(cat "$r/name" 2>/dev/null)" = "$name" ] && { rproc=$r; break; }
done
[ -n "$rproc" ] || { log "$name: no remoteproc"; exit 1; }
# Without recovery a crash would leave the DSP down: refuse, as PICO OS's restart level SYSTEM.
recovery=/sys/kernel/debug/remoteproc/${rproc##*/}/recovery
if [ -e "$recovery" ] && [ "$(cat "$recovery")" != enabled ]; then
	log "$name: crash recovery is off, not starting"
	exit 1
fi

state=$(cat "$rproc/state")
if [ "$state" = running ]; then
	log "$name: already running"
	exit 0
fi
log "$name: starting $(cat "$rproc/firmware") (state $state)"
write start "$rproc/state"
for _ in $(seq 1 "${2:-30}"); do
	state=$(cat "$rproc/state")
	if [ "$state" = running ]; then
		log "$name: running"
		exit 0
	fi
	sleep 1
done
log "$name: not running after start (state $state)"
dmesg | grep -iE "remoteproc|$name|q6v5" | tail -n 20 | while IFS= read -r line; do log "$name: $line"; done
exit 1
