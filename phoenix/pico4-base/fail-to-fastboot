#!/bin/bash
# SPDX-License-Identifier: Unlicense
# Called instead of a console shell when systemd enters emergency or rescue
# mode. Keeps a short window for an existing SSH session to collect logs.
. /usr/libexec/pico4/lib.sh
log "userspace: entered ${1:-emergency} mode; rebooting to fastboot in $(stage1_arg emergency_delay 30)s"
systemctl --failed --no-legend --plain 2>/dev/null | while read -r line; do log "failed: $line"; done
sleep "$(stage1_arg emergency_delay 30)"
sync
exec /usr/bin/pico4-reboot bootloader
