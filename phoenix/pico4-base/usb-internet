#!/usr/bin/env python3
# SPDX-License-Identifier: Unlicense
"""Route the headset's internet through the PC on the USB link (docs/userspace.md#internet-over-usb).

The PC end of the link (pico4.host_ip=, 172.16.42.2 by default, the one DHCP lease of the link)
becomes the default gateway and DNS server of the USB interface, in a drop-in for the link's
network file (50-pico4-usb.network). With the PC sharing its internet at that address (Windows'
internet connection sharing), the headset is online; without it the route leads nowhere. Its
metric is above NetworkManager's Wi-Fi and Ethernet routes, so those win when they exist.

    usb-internet [CMDLINE_FILE [OUTPUT]]
"""

from __future__ import annotations

import ipaddress
import sys
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Sequence

DEFAULT_HOST_IP = "172.16.42.2"
#: Above NetworkManager's defaults (Ethernet 100, Wi-Fi 600): the USB link is the last resort.
METRIC = 2048
DROPIN = Path("/run/systemd/network/50-pico4-usb.network.d/60-pico4-internet.conf")


def host_ip(cmdline: str) -> str:
    """Return the PC's address on the USB link from the kernel command line (pico4.host_ip=)."""
    value = DEFAULT_HOST_IP
    for arg in cmdline.split():
        if arg.startswith("pico4.host_ip="):
            value = arg.split("=", 1)[1]
    return str(ipaddress.IPv4Address(value))


def dropin(gateway: str) -> str:
    """Return the network drop-in's text: GATEWAY as the route and the DNS server."""
    return (
        "# Written by pico4-usb-internet.service: the PC shares its internet over the USB link.\n"
        "[Network]\n"
        f"DNS={gateway}\n"
        "\n"
        "[Route]\n"
        f"Gateway={gateway}\n"
        f"Metric={METRIC}\n"
    )


def main(argv: Sequence[str] | None = None) -> int:
    """Write the drop-in from the kernel command line (arguments: its file and the output for tests)."""
    args = sys.argv[1:] if argv is None else argv
    cmdline = Path(args[0] if args else "/proc/cmdline").read_text()
    output = Path(args[1]) if len(args) > 1 else DROPIN
    try:
        gateway = host_ip(cmdline)
    except ValueError as exc:
        print(f"usb-internet: pico4.host_ip: {exc}", file=sys.stderr)
        return 1
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(dropin(gateway))
    return 0


if __name__ == "__main__":
    sys.exit(main())
