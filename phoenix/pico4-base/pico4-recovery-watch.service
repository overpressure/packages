[Unit]
Description=PICO 4 recovery deadline (return to fastboot when unreachable or a test overruns)
DefaultDependencies=no
After=systemd-journald.socket
# Must survive emergency/rescue isolation and shutdown requests that hang.
IgnoreOnIsolate=yes

[Service]
ExecStart=/usr/libexec/pico4/recovery-watch
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
