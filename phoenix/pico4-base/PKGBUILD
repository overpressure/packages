        remoteproc-boot
        usb-gadget
        usb-internet
        venus-probe
        wlan-address
        wlan-probe
        vrdevice_path
        test_clock.py test_config.py test_qca6390.py test_usb_internet.py
        test_boot_attempts.sh test_charger.sh
        50-pico4-base.preset)
