build() {
  python3 -B -m unittest test_clock test_config test_qca6390 test_usb_internet
  bash test_boot_attempts.sh
  bash test_charger.sh
}

package() {
  install -Dm644 50-pico4-usb.conf "$pkgdir/etc/NetworkManager/conf.d/50-pico4-usb.conf"
  install -Dm644 50-pico4-wifi-address.conf "$pkgdir/etc/NetworkManager/conf.d/50-pico4-wifi-address.conf"
  install -Dm644 50-pico4-wifi-autoconnect.conf "$pkgdir/etc/NetworkManager/conf.d/50-pico4-wifi-autoconnect.conf"
  install -Dm644 main.conf "$pkgdir/etc/iwd/main.conf"
  install -Dm644 sshd_config.d-50-pico4.conf "$pkgdir/etc/ssh/sshd_config.d/50-pico4.conf"
  install -Dm644 50-pico4-console.conf "$pkgdir/etc/sysctl.d/50-pico4-console.conf"
  install -Dm644 50-pico4-memory.conf "$pkgdir/etc/sysctl.d/50-pico4-memory.conf"
  install -Dm644 50-pico4-limit.conf "$pkgdir/etc/systemd/coredump.conf.d/50-pico4-limit.conf"
  install -Dm644 home.mount "$pkgdir/etc/systemd/system/home.mount"
  install -Dm644 journald.conf.d-50-pico4.conf "$pkgdir/usr/lib/systemd/journald.conf.d/50-pico4.conf"
  install -Dm644 10-pico4-wlan.link "$pkgdir/usr/lib/systemd/network/10-pico4-wlan.link"
  install -Dm644 50-pico4-usb.network "$pkgdir/usr/lib/systemd/network/50-pico4-usb.network"
  install -Dm644 system.conf.d-50-pico4.conf "$pkgdir/usr/lib/systemd/system.conf.d/50-pico4.conf"
  install -Dm644 emergency.service.d-pico4.conf "$pkgdir/usr/lib/systemd/system/emergency.service.d/pico4.conf"
  install -Dm644 rescue.service.d-pico4.conf "$pkgdir/usr/lib/systemd/system/rescue.service.d/pico4.conf"
  install -Dm644 pico4-venus.conf "$pkgdir/usr/lib/systemd/system/steam-video-codec-setup.service.d/pico4-venus.conf"
  install -Dm644 pico4-boot-ok.service "$pkgdir/usr/lib/systemd/system/pico4-boot-ok.service"
  install -Dm644 pico4-bt-address.service "$pkgdir/usr/lib/systemd/system/pico4-bt-address.service"
  install -Dm644 pico4-bt-firmware.service "$pkgdir/usr/lib/systemd/system/pico4-bt-firmware.service"
  install -Dm644 pico4-charger.service "$pkgdir/usr/lib/systemd/system/pico4-charger.service"
  install -Dm644 pico4-charger.target "$pkgdir/usr/lib/systemd/system/pico4-charger.target"
  install -Dm644 pico4-clock.service "$pkgdir/usr/lib/systemd/system/pico4-clock.service"
  install -Dm644 pico4-panel-probe.service "$pkgdir/usr/lib/systemd/system/pico4-panel-probe.service"
  install -Dm644 pico4-persist.service "$pkgdir/usr/lib/systemd/system/pico4-persist.service"
  install -Dm644 pico4-recovery-watch.service "$pkgdir/usr/lib/systemd/system/pico4-recovery-watch.service"
  install -Dm644 pico4-splash.service "$pkgdir/usr/lib/systemd/system/pico4-splash.service"
  install -Dm644 pico4-storage-ro.service "$pkgdir/usr/lib/systemd/system/pico4-storage-ro.service"
  install -Dm644 pico4-usb-gadget.service "$pkgdir/usr/lib/systemd/system/pico4-usb-gadget.service"
  install -Dm644 pico4-usb-internet.service "$pkgdir/usr/lib/systemd/system/pico4-usb-internet.service"
  install -Dm644 pico4-venus-probe.service "$pkgdir/usr/lib/systemd/system/pico4-venus-probe.service"
  install -Dm644 pico4-wlan-address.service "$pkgdir/usr/lib/systemd/system/pico4-wlan-address.service"
  install -Dm644 pico4-wlan-probe.service "$pkgdir/usr/lib/systemd/system/pico4-wlan-probe.service"
  install -Dm644 pico4-zram-swap.service "$pkgdir/usr/lib/systemd/system/pico4-zram-swap.service"
  install -Dm644 pico4-usb-gadget.conf "$pkgdir/usr/lib/tmpfiles.d/pico4-usb-gadget.conf"
  install -Dm644 00-pico4-devnodes.rules "$pkgdir/usr/lib/udev/rules.d/00-pico4-devnodes.rules"
  install -Dm755 boot-attempts "$pkgdir/usr/libexec/pico4/boot-attempts"
  install -Dm755 bt-address "$pkgdir/usr/libexec/pico4/bt-address"
  install -Dm755 bt-firmware "$pkgdir/usr/libexec/pico4/bt-firmware"
  install -Dm755 charger "$pkgdir/usr/libexec/pico4/charger"
  install -Dm755 clock "$pkgdir/usr/libexec/pico4/clock"
  install -Dm755 devnode "$pkgdir/usr/libexec/pico4/devnode"
  install -Dm755 fail-to-fastboot "$pkgdir/usr/libexec/pico4/fail-to-fastboot"
  install -Dm755 persist "$pkgdir/usr/libexec/pico4/persist"
  install -Dm755 preinit "$pkgdir/usr/libexec/pico4/preinit"
  install -Dm755 remoteproc-boot "$pkgdir/usr/libexec/pico4/remoteproc-boot"
  install -Dm755 usb-gadget "$pkgdir/usr/libexec/pico4/usb-gadget"
  install -Dm755 usb-internet "$pkgdir/usr/libexec/pico4/usb-internet"
  install -Dm755 venus-probe "$pkgdir/usr/libexec/pico4/venus-probe"
  install -Dm755 wlan-address "$pkgdir/usr/libexec/pico4/wlan-address"
  install -Dm755 wlan-probe "$pkgdir/usr/libexec/pico4/wlan-probe"
  install -Dm755 vrdevice_path "$pkgdir/usr/local/bin/vrdevice_path"
  install -Dm644 50-pico4-base.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
