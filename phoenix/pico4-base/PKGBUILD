# The PICO 4's system around Valve's userspace: preinit (the first process: boot count, data partition,
# charger mode), the read-only storage policy and the recovery deadline, PICO OS's persist partition, the
# USB link to the PC (gadget, network, the PC as a last-resort gateway), Wi-Fi and Bluetooth with their
# addresses from persist, the wall clock, the firmware probes (Wi-Fi, video codec, panels), zram swap and the
# system's policy files. preinit and charger mode source stage 1's lib.sh, which the image takes from stage 1.
# The preset enables the services; the tests run in the build.
pkgname=pico4-base
pkgver=1
pkgrel=1
pkgdesc="PICO 4 system: preinit, storage and recovery policy, USB link, network, clock, firmware probes"
arch=(any)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/NetworkManager/conf.d/50-pico4-usb.conf
        etc/NetworkManager/conf.d/50-pico4-wifi-address.conf
        etc/NetworkManager/conf.d/50-pico4-wifi-autoconnect.conf
        etc/iwd/main.conf
        etc/ssh/sshd_config.d/50-pico4.conf
        etc/sysctl.d/50-pico4-console.conf
        etc/sysctl.d/50-pico4-memory.conf
        etc/systemd/coredump.conf.d/50-pico4-limit.conf
        etc/systemd/system/home.mount)
source=(50-pico4-usb.conf
        50-pico4-wifi-address.conf
