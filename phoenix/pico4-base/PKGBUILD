build() {
  python3 -B -m unittest test_clock test_config test_qca6390
  bash test_charger.sh
}

package() {
  install -Dm644 50-pico4-wifi-address.conf "$pkgdir/etc/NetworkManager/conf.d/50-pico4-wifi-address.conf"
  install -Dm644 50-pico4-wifi-autoconnect.conf "$pkgdir/etc/NetworkManager/conf.d/50-pico4-wifi-autoconnect.conf"
  install -Dm644 main.conf "$pkgdir/etc/iwd/main.conf"
  install -Dm644 50-pico4-console.conf "$pkgdir/etc/sysctl.d/50-pico4-console.conf"
  install -Dm644 50-pico4-memory.conf "$pkgdir/etc/sysctl.d/50-pico4-memory.conf"
  install -Dm644 50-pico4-zram.conf "$pkgdir/usr/lib/systemd/zram-generator.conf.d/50-pico4.conf"
  install -Dm644 50-pico4-limit.conf "$pkgdir/etc/systemd/coredump.conf.d/50-pico4-limit.conf"
  install -Dm644 10-pico4-wlan.link "$pkgdir/usr/lib/systemd/network/10-pico4-wlan.link"
  local unit
  for unit in bt-address bt-firmware charger clock panel-probe splash wlan-address zram-swap; do
    install -Dm644 "pico4-$unit.service" "$pkgdir/usr/lib/systemd/system/pico4-$unit.service"
  done
  install -Dm644 pico4-charger.target "$pkgdir/usr/lib/systemd/system/pico4-charger.target"
  install -Dm644 sm8250-persist.service.d-50-pico4-controllers.conf \
    "$pkgdir/usr/lib/systemd/system/sm8250-persist.service.d/50-pico4-controllers.conf"
  install -Dm644 preinit-early.sh "$pkgdir/usr/lib/overpressure/preinit/early.d/50-pico4.sh"
  install -Dm644 preinit-mounted.sh "$pkgdir/usr/lib/overpressure/preinit/mounted.d/50-pico4.sh"
  local program
  for program in bt-address bt-firmware charger clock controller-tables wlan-address; do
    install -Dm755 "$program" "$pkgdir/usr/libexec/pico4/$program"
  done
  install -Dm755 vrdevice_path "$pkgdir/usr/local/bin/vrdevice_path"
  install -Dm644 50-pico4-base.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
