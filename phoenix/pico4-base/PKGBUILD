# The PICO 4's system around Valve's userspace, on overpressure-base and sm8250-base: preinit's PICO 4 hooks
# (charger mode; PICO OS's firmware partitions, the head tracker's root and the boot splash), charger mode,
# Wi-Fi and Bluetooth with their addresses from persist, the controllers' bias tables from persist, the wall
# clock, the panel probe, zram swap and the PICO 4's policy files. The preset enables the services; the tests
# run in the build.
pkgname=pico4-base
pkgver=2026.11.25
pkgrel=1
pkgdesc="PICO 4 system: preinit hooks, charger mode, Wi-Fi and Bluetooth addresses, clock, panel probe"
arch=(any)
url="https://github.com/overpressure/phoenix/tree/main/docs"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/NetworkManager/conf.d/50-pico4-wifi-address.conf
        etc/NetworkManager/conf.d/50-pico4-wifi-autoconnect.conf
        etc/iwd/main.conf
        etc/sysctl.d/50-pico4-console.conf
        etc/sysctl.d/50-pico4-memory.conf
        etc/systemd/coredump.conf.d/50-pico4-limit.conf)
source=(50-pico4-wifi-address.conf
        50-pico4-wifi-autoconnect.conf
        main.conf
        50-pico4-console.conf
        50-pico4-memory.conf
        50-pico4-zram.conf
        50-pico4-limit.conf
        10-pico4-wlan.link
        pico4-bt-address.service
        pico4-bt-firmware.service
        pico4-charger.service
        pico4-charger.target
        pico4-clock.service
        pico4-panel-probe.service
        pico4-splash.service
        pico4-wlan-address.service
        pico4-zram-swap.service
        sm8250-persist.service.d-50-pico4-controllers.conf
        preinit-early.sh
        preinit-mounted.sh
        bt-address
        bt-firmware
        charger
        clock
        controller-tables
        wlan-address
        vrdevice_path
        test_clock.py test_config.py test_qca6390.py
        test_charger.sh
        50-pico4-base.preset)
