        system.conf.d-50-pico4.conf
        emergency.service.d-pico4.conf
        rescue.service.d-pico4.conf
        pico4-venus.conf
        pico4-boot-ok.service
        pico4-bt-address.service
        pico4-bt-firmware.service
        pico4-charger.service
        pico4-charger.target
        pico4-clock.service
        pico4-panel-probe.service
        pico4-persist.service
        pico4-recovery-watch.service
        pico4-splash.service
        pico4-storage-ro.service
        pico4-usb-gadget.service
        pico4-usb-internet.service
        pico4-venus-probe.service
        pico4-wlan-address.service
        pico4-wlan-probe.service
        pico4-zram-swap.service
        pico4-usb-gadget.conf
        00-pico4-devnodes.rules
        boot-attempts
        bt-address
        bt-firmware
        charger
        clock
        devnode
        fail-to-fastboot
        persist
        preinit
        remoteproc-boot
        steamos-readonly
        usb-gadget
        usb-internet
        venus-probe
        wlan-address
        wlan-probe
        vrdevice_path
        test_clock.py test_config.py test_qca6390.py test_usb_internet.py
        test_boot_attempts.sh test_charger.sh test_steamos_readonly.sh
        50-pico4-base.preset)
