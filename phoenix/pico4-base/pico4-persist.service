# PICO OS's persist partition read-only at /mnt/vendor/persist (docs/userspace.md): the
# headset's own factory data, which the sensor DSP, the driver, the tracker, the fan and Wi-Fi
# read through links in the image. Before local-fs.target, so every service finds it.
[Unit]
Description=PICO 4 persist partition (read-only)
DefaultDependencies=no
After=pico4-storage-ro.service
Before=local-fs.target
ConditionPathExists=/dev/block/by-name/persist

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4/persist

[Install]
WantedBy=local-fs.target
