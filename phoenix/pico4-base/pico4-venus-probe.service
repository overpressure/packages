# The video codec: probed again once its firmware is in /usr/lib/firmware
# (docs/session.md#steam-link).
[Unit]
Description=Video codec (Venus)
DefaultDependencies=no
ConditionPathExists=/usr/lib/firmware/venus.mdt
ConditionPathExists=/sys/bus/platform/drivers/qcom-venus
After=systemd-modules-load.service local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4/venus-probe

[Install]
WantedBy=sysinit.target
