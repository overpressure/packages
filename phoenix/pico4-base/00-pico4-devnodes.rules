# The PICO 4 Linux's storage policy: every physical disk and partition is switched read-only
# when it appears and gets a /dev/block/by-name link. These rules run first, so that no other rule
# sees a writable disk.

SUBSYSTEM!="block", GOTO="pico4_devnodes_end"
ACTION=="remove", ENV{DEVNAME}=="?*", RUN+="/usr/libexec/pico4/devnode remove"
ACTION=="remove", GOTO="pico4_devnodes_end"
ENV{DEVNAME}=="?*", ENV{MAJOR}=="?*", PROGRAM="/usr/libexec/pico4/devnode add"
LABEL="pico4_devnodes_end"

