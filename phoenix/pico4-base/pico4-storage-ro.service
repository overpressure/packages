[Unit]
Description=PICO 4 storage policy (all physical block devices read-only)
DefaultDependencies=no
Before=local-fs-pre.target systemd-udev-trigger.service
Wants=local-fs-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4/devnode sweep

[Install]
WantedBy=sysinit.target
