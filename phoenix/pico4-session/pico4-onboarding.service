# The first-run setup in the headset (docs/session.md#first-run-setup). It runs with SteamVR and
# exits at once once the setup is done.
[Unit]
Description=PICO 4 first-run setup in SteamVR
PartOf=steamvr.service
After=steamvr.service

[Service]
ExecStart=/usr/bin/pico4-onboarding
Restart=on-failure
RestartSec=5
