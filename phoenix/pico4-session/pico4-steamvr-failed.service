# SteamVR failed for good (its start limit, see steamvr.service.d): end Valve's session
# target, or gamescope would stay without SteamVR and the lenses dark. Its
# start-gamescope-session returns, and pico4-session.service starts a new session
# (within its own start limit), which resets SteamVR's counter (docs/session.md).
[Unit]
Description=End the session after SteamVR failed

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --user stop gamescope-session.target
