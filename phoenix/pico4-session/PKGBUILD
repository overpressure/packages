build() {
  python3 -B -m unittest test_session_units test_steamvr_settings test_steam_proton_mapping test_vr_performance test_first_run_setup test_atomupd
}

package() {
  install -Dm644 pico4-session "$pkgdir/etc/pam.d/pico4-session"
  install -Dm644 session.pam-env "$pkgdir/etc/pico4/session.pam-env"
  install -Dm644 rtkit-limits.conf "$pkgdir/etc/systemd/system/rtkit-daemon.service.d/rtkit-limits.conf"
  install -Dm644 50-pico4-restart-limit.conf "$pkgdir/etc/systemd/user/steamvr.service.d/50-pico4-restart-limit.conf"
  install -Dm755 atomupd-manager "$pkgdir/usr/bin/atomupd-manager"
  install -Dm755 displays_turn_off_drm_master "$pkgdir/usr/bin/displays_turn_off_drm_master"
  install -Dm755 steamos-set-timezone "$pkgdir/usr/bin/steamos-polkit-helpers/steamos-set-timezone"
  install -Dm755 steamos-update "$pkgdir/usr/bin/steamos-polkit-helpers/steamos-update"
  install -Dm644 pico4-kthread-priorities.service "$pkgdir/usr/lib/systemd/system/pico4-kthread-priorities.service"
  install -Dm644 pico4-monado.service "$pkgdir/usr/lib/systemd/system/pico4-monado.service"
  install -Dm644 pico4-monado.socket "$pkgdir/usr/lib/systemd/system/pico4-monado.socket"
  install -Dm644 pico4-session.service "$pkgdir/usr/lib/systemd/system/pico4-session.service"
  install -Dm644 pico4-vr-performance.service "$pkgdir/usr/lib/systemd/system/pico4-vr-performance.service"
  install -Dm644 gamescope-session.service.d-50-pico4.conf "$pkgdir/usr/lib/systemd/user/gamescope-session.service.d/50-pico4.conf"
  install -Dm644 pico4-lens-panel.service "$pkgdir/usr/lib/systemd/user/pico4-lens-panel.service"
  install -Dm644 pico4-onboarding.service "$pkgdir/usr/lib/systemd/user/pico4-onboarding.service"
  install -Dm644 pico4-roomview.service "$pkgdir/usr/lib/systemd/user/pico4-roomview.service"
  install -Dm644 pico4-steamvr-failed.service "$pkgdir/usr/lib/systemd/user/pico4-steamvr-failed.service"
  install -Dm644 steam.service.d-50-pico4.conf "$pkgdir/usr/lib/systemd/user/steam.service.d/50-pico4.conf"
  install -Dm644 55-pico4-first-run.conf "$pkgdir/usr/lib/systemd/user/steam.service.d/55-pico4-first-run.conf"
  install -Dm644 steamvr.service.d-50-pico4.conf "$pkgdir/usr/lib/systemd/user/steamvr.service.d/50-pico4.conf"
  install -Dm644 52-pico4-roomview.conf "$pkgdir/usr/lib/systemd/user/steamvr.service.d/52-pico4-roomview.conf"
  install -Dm644 53-pico4-lens-panel.conf "$pkgdir/usr/lib/systemd/user/steamvr.service.d/53-pico4-lens-panel.conf"
  install -Dm644 54-pico4-onboarding.conf "$pkgdir/usr/lib/systemd/user/steamvr.service.d/54-pico4-onboarding.conf"
  install -Dm644 pico4-steamos.conf "$pkgdir/usr/lib/sysusers.d/pico4-steamos.conf"
  install -Dm755 kthread-priorities "$pkgdir/usr/libexec/pico4/kthread-priorities"
  install -Dm755 monado-service "$pkgdir/usr/libexec/pico4/monado-service"
  install -Dm755 session "$pkgdir/usr/libexec/pico4/session"
  install -Dm755 steam-language "$pkgdir/usr/libexec/pico4/steam-language"
  install -Dm755 steam-proton-mapping "$pkgdir/usr/libexec/pico4/steam-proton-mapping"
  install -Dm755 steamvr-ended "$pkgdir/usr/libexec/pico4/steamvr-ended"
  install -Dm755 steamvr-settings "$pkgdir/usr/libexec/pico4/steamvr-settings"
  install -Dm755 vr-performance "$pkgdir/usr/libexec/pico4/vr-performance"
  install -Dm755 wait-first-run "$pkgdir/usr/libexec/pico4/wait-first-run"
  install -Dm644 50-pico4-timezone.rules "$pkgdir/usr/share/polkit-1/rules.d/50-pico4-timezone.rules"
  install -Dm644 frame-controller-remapping.json "$pkgdir/usr/share/pico4/frame-controller-remapping.json"
  install -Dm644 openvrpaths.vrpath "$pkgdir/usr/share/pico4/openvrpaths.vrpath"
  install -Dm644 steamvr.vrsettings "$pkgdir/usr/share/pico4/steamvr.vrsettings"
  install -Dm644 50-pico4-session.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
