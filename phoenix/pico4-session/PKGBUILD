# Valve's VR session on the PICO 4: pico4-session starts the Frame's session for its user without a display
# manager; Monado as a system service for driver_monado; SteamVR's settings, the room view, the lens panel,
# the first run's introduction and setup, SteamVR's and Steam's drop-ins, the VR CPU limits, the kernel
# threads' priorities, the Frame's polkit helpers and updater answered for this headset, and the session's
# SteamVR files (/usr/share/pico4: settings, openvrpaths, the Frame controller's layout), which the image's
# build puts into the user's home and SteamVR's remapping. The preset enables the session; the tests run in
# the build.
pkgname=pico4-session
pkgver=1
pkgrel=1
pkgdesc="PICO 4 session: Valve's VR session started without a display manager, with SteamVR and Steam set up for the PICO 4"
arch=(any)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/pam.d/pico4-session
        etc/pico4/session.pam-env
        etc/systemd/system/rtkit-daemon.service.d/rtkit-limits.conf
        etc/systemd/user/steamvr.service.d/50-pico4-restart-limit.conf)
source=(pico4-session
        session.pam-env
        rtkit-limits.conf
        50-pico4-restart-limit.conf
        atomupd-manager
        displays_turn_off_drm_master
        steamos-set-timezone
        steamos-update
        pico4-kthread-priorities.service
        pico4-monado.service
        pico4-monado.socket
        pico4-session.service
        pico4-vr-performance.service
        gamescope-session.service.d-50-pico4.conf
        pico4-lens-panel.service
        pico4-onboarding.service
        pico4-roomview.service
        pico4-steamvr-failed.service
        steam.service.d-50-pico4.conf
        55-pico4-first-run.conf
        steamvr.service.d-50-pico4.conf
        52-pico4-roomview.conf
        53-pico4-lens-panel.conf
        54-pico4-onboarding.conf
        pico4-steamos.conf
        kthread-priorities
        monado-service
        session
        steam-language
        steam-proton-mapping
        steamvr-ended
        steamvr-settings
        vr-performance
        wait-first-run
        50-pico4-timezone.rules
        frame-controller-remapping.json
        openvrpaths.vrpath
        steamvr.vrsettings
        50-pico4-session.preset
        test_session_units.py
        test_steamvr_settings.py
        test_steam_proton_mapping.py
        test_vr_performance.py
        test_first_run_setup.py
        test_atomupd.py)
