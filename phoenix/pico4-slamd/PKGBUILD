build() {
  python3 -B -m unittest test_slamd
  # The build host's clang where the build environment links one in (x86-64 hosts), else Arch's.
  CLANG=$(command -v aarch64-unknown-linux-gnu-clang || command -v clang) bash build.sh out .
}

package() {
  local root="$pkgdir/usr/lib/pico4-stock-slam"
  install -Dm755 out/pico4-slamd -t "$root/pico4"
  install -Dm644 out/libpico4-slam-stubs.so out/libpico4-fastrpc-bridge.so out/libandroid.so -t "$root/pico4"
  # Mount points: the system image is read-only on the headset.
  install -dm755 "$root"/{dev,proc,sys,data,tmp,system,vendor,mnt/vendor/persist/pvr,mnt/vendor/pvr}
}
