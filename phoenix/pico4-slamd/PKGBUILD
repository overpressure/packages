# pico4-slamd: PICO OS's head tracker (libSlam), its auto exposure and depth mesh, hosted in the tracker's
# bionic root, and the root's stand-ins of this project (libandroid, the FastRPC bridge, the logging and
# CVP stubs). Built for bionic (aarch64-linux-android29) with clang and lld, against stand-ins of bionic's
# libc, libm and libdl: no file of PICO's. The headset binds PICO OS's own parts of the root in at boot
# (pico4-base's preinit, from the data partition's copy and the dsp partition); this package holds the
# root's own programs and its mount points. The image-processing tests run natively first.
pkgname=pico4-slamd
pkgver=1
pkgrel=1
pkgdesc="PICO 4 head tracker host for PICO OS's libSlam in its bionic root"
arch=(aarch64)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
makedepends=(clang lld python)
options=(!strip !debug)
source=(build.sh crt.c pico4-slamd.c vst.c vst.h stubs.c android.c fastrpc-bridge.c fastrpc_bridge.h bionic.h isp.h
        room.h bionic-stubs.c bionic-stubs.map pico4_slam_feed.h test_isp.c test_room.c test_fastrpc_bridge.c
        test_slamd.py)
sha256sums=('24d211e81a71dfd7c3e59a15f4adcb46c6c64c63f7e58576378e3cf8c0c309d5'
