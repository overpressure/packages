#!/bin/bash
# SPDX-License-Identifier: Unlicense
# The installed system's log drive (the maintenance stage 1 has its own, initramfs .../logdisk):
# rewrite the read-only USB mass-storage medium with this boot's journal, unit and network
# state. It reaches the PC even when the USB network does not.
#
#   userspace-logdisk                 (pico4-userspace-logdisk.service)
#   userspace-logdisk --tail BYTES    stdin as the drive's journal takes it (the tests)
set -u
# FAT's own tables and the clusters' rounding take at most this of the drive (2 MiB of 32).
LOGDISK_SLACK=2097152
# logdisk_tail BYTES: stdin, or, when it is longer, its last BYTES from the first whole line on,
# after a note. Only those bytes are held.
logdisk_tail() {
	local data
	data=$(mktemp)
	tail -c "$(($1 + 1))" > "$data"
	if [ "$(stat -c %s "$data")" -le "$1" ]; then
		cat "$data"
	else
		echo "-- the journal's older lines do not fit on the drive: journalctl -b on the headset has them"
		sed 1d "$data"
	fi
	rm -f "$data"
}
[ "${1:-}" != --tail ] || { logdisk_tail "$2"; exit; }
. /usr/libexec/pico4/lib.sh
IMG=$P4_RUN/logdisk.img
LUN=/sys/kernel/config/usb_gadget/pico4/functions/mass_storage.0/lun.0
export MTOOLS_SKIP_CHECK=1
[ -e "$LUN/file" ] || exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$IMG.new"' EXIT
{
	echo "PICO 4 SteamOS-compatible userspace - log drive, refreshed every 2 minutes"
	echo "boot.log: preinit; journal.txt: this boot (its newest lines that fit); state.txt: units and network"
} | sed 's/$/\r/' > "$tmp/README.txt"
cp "$P4_LOG" "$tmp/boot.log" 2>/dev/null
dmesg > "$tmp/dmesg.txt" 2>&1
{
	echo "== systemctl is-system-running: $(systemctl is-system-running 2>&1)"
	systemctl list-units --failed --no-pager --plain
	systemctl list-jobs --no-pager
	echo "== links"; ip -d link
	echo "== addresses"; ip addr
	echo "== routes"; ip route
	echo "== networkctl"; networkctl list --no-pager
	echo "== usb-link.env"; cat /run/pico4/usb-link.env
	echo "== sshd"; systemctl status sshd --no-pager -l
	echo "== udc"; cat "$LUN/../../../UDC" /sys/class/udc/*/state 2>&1
} > "$tmp/state.txt" 2>&1
pico4-userspace-check --wait 1 --no-vulkan > "$tmp/check.json" 2>&1
cp /etc/pico4/build-info "$tmp/build-info.json" 2>/dev/null
# The journal last, in what the drive has left: a session's boot outgrows the drive within the
# hour, and a drive that does not fit fails the unit and with it the system's state. A journal
# that does not fit keeps its newest lines, from the first whole one.
mb=$(stage1_arg logdisk_mb 32)
room=$(( mb * 1048576 - $(du -sb "$tmp" | cut -f1) - LOGDISK_SLACK ))
[ "$room" -gt 0 ] || room=1
# journalctl -n reads from the end: more lines than a drive takes, without reading a long boot whole.
journalctl -b -n 400000 --no-pager -o short-monotonic 2>&1 | logdisk_tail "$room" > "$tmp/journal.txt"

dd if=/dev/zero of="$IMG.new" bs=1M count="$mb" status=none &&
	mformat -i "$IMG.new" -v PICO4LOGS :: >/dev/null &&
	mcopy -s -i "$IMG.new" "$tmp"/* :: >/dev/null || { log "userspace logdisk: could not build the image"; exit 1; }
mv -f "$IMG.new" "$IMG"
# The PC may hold the medium: eject it first (it sees a media change).
if ! echo "$IMG" > "$LUN/file" 2>/dev/null; then
	echo 1 > "$LUN/forced_eject" 2>/dev/null
	echo "$IMG" > "$LUN/file" 2>/dev/null || { log "userspace logdisk: medium busy"; exit 1; }
fi
