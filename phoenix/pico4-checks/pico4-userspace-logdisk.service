[Unit]
Description=PICO 4 log drive (journal and state on the USB mass-storage function)
# No ordering after multi-user.target: it must also report a boot that hangs.
DefaultDependencies=no
After=systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/pico4/userspace-logdisk
# Every 2 minutes, during sessions too: only time the CPUs and the storage have spare.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
