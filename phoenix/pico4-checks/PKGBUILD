# The PICO 4's checks, which the host's dev check and the installer run over SSH: pico4-userspace-check and
# pico4-valve-session-check (with msm-frame-stats and session-performance; their JSON is what the host
# reads), the suspend check, the support bundle, the log drive on the USB link and the link's samples after
# boot. The preset enables the log drive and the link samples; the tests run in the build.
pkgname=pico4-checks
pkgver=1
pkgrel=1
pkgdesc="PICO 4 checks: the system's and the VR session's acceptance checks, the support bundle, the log drive"
arch=(any)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
depends=(bash python systemd)
source=(pico4-support-bundle
        pico4-suspend-check
        pico4-userspace-check
        pico4-valve-session-check
        pico4-userspace-logdisk.service
        pico4-userspace-logdisk.timer
        pico4-userspace-netdiag.service
        msm-frame-stats
        session-performance
        userspace-logdisk
        userspace-netdiag
        50-pico4-checks.preset
        test_logdisk.py
        test_msm_frame_stats.py
        test_session_performance.py
        test_support_bundle.py
        test_suspend_check.py)
sha256sums=('83c000aeb2f6834844c79b5dbac32b76f866f0431461bf89b92415eaff29f8b6'
            '49ee620087f9d92b65a98a664850338b4ff875821c849017a186e74da316fdcf'
