build() {
  python3 -B -m unittest test_logdisk test_msm_frame_stats test_session_performance test_support_bundle test_suspend_check
}

package() {
  install -Dm755 pico4-support-bundle "$pkgdir/usr/bin/pico4-support-bundle"
  install -Dm755 pico4-suspend-check "$pkgdir/usr/bin/pico4-suspend-check"
  install -Dm755 pico4-userspace-check "$pkgdir/usr/bin/pico4-userspace-check"
  install -Dm755 pico4-valve-session-check "$pkgdir/usr/bin/pico4-valve-session-check"
  install -Dm644 pico4-userspace-logdisk.service "$pkgdir/usr/lib/systemd/system/pico4-userspace-logdisk.service"
  install -Dm644 pico4-userspace-logdisk.timer "$pkgdir/usr/lib/systemd/system/pico4-userspace-logdisk.timer"
  install -Dm644 pico4-userspace-netdiag.service "$pkgdir/usr/lib/systemd/system/pico4-userspace-netdiag.service"
  install -Dm755 msm-frame-stats "$pkgdir/usr/libexec/pico4/msm-frame-stats"
  install -Dm755 session-performance "$pkgdir/usr/libexec/pico4/session-performance"
  install -Dm755 userspace-logdisk "$pkgdir/usr/libexec/pico4/userspace-logdisk"
  install -Dm755 userspace-netdiag "$pkgdir/usr/libexec/pico4/userspace-netdiag"
  install -Dm644 50-pico4-checks.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
