# The PICO 4's checks, which the host's dev check and the installer run over SSH: pico4-userspace-check and
# pico4-valve-session-check (with msm-frame-stats and session-performance; their JSON is what the host
# reads), the suspend check, the support bundle and the link's samples after
# boot. The preset enables the link samples; the tests run in the build.
pkgname=pico4-checks
pkgver=1
pkgrel=3
pkgdesc="PICO 4 checks: the system's and the VR session's acceptance checks, the support bundle"
arch=(any)
url="https://github.com/overpressure/phoenix/tree/main/docs"
license=(Unlicense)
depends=(bash python systemd)
source=(pico4-support-bundle
        pico4-suspend-check
        pico4-userspace-check
        pico4-valve-session-check
        pico4-userspace-netdiag.service
        msm-frame-stats
        session-performance
        userspace-netdiag
        50-pico4-checks.preset
        test_msm_frame_stats.py
        test_session_performance.py
        test_support_bundle.py
        test_suspend_check.py)
sha256sums=('83c000aeb2f6834844c79b5dbac32b76f866f0431461bf89b92415eaff29f8b6'
            '49ee620087f9d92b65a98a664850338b4ff875821c849017a186e74da316fdcf'
            '39d55d0cf6ecaa026f8502c5b2b2d47af4d94eb823e47829f9c3dde11244a1e3'
            'ad8b81ada874a1121e0a07d5d225af84ef0b57adbd63d17c632ecfd126915a48'
            '217d4d3db717e8cdb576035d0624b1572ea02eb2152dfe04b26ce51e49ed73f7'
            'a48b847f2a7993d3b369f540746687760600ddf91ead6d0c0f3144856bed9492'
            '454156206a62fa0b7dea261238feb5e7350013382397891c680feb1ce7bf9ee0'
            '6a200b04535d5b9eac356d120b8f46a8f7987fb87590a77609b041c2155cb93f'
            '43a502265d0d94d117b4e30bad443348238a904948334e3ad634e822d87ed63a'
            'f07de3d3b4df5f17c154ed24cbce1475b7abd7827222604c185a018920ab4d11'
            'f0eaf22820c981198a319c89b00967b91c8bd2e3a3b286cba7e4a10469db286a'
            '71f8feb17dc54eb08505042fd5f7fd685b8f31c9c6acd44c5b2885dbe2dd5600'
            'bad444faaafc81249c69d06807c9c863ab0c63dee2e945b39a2694ce4541c44f')

build() {
  python3 -B -m unittest test_msm_frame_stats test_session_performance test_support_bundle test_suspend_check
}

package() {
  install -Dm755 pico4-support-bundle "$pkgdir/usr/bin/pico4-support-bundle"
  install -Dm755 pico4-suspend-check "$pkgdir/usr/bin/pico4-suspend-check"
  install -Dm755 pico4-userspace-check "$pkgdir/usr/bin/pico4-userspace-check"
  install -Dm755 pico4-valve-session-check "$pkgdir/usr/bin/pico4-valve-session-check"
  install -Dm644 pico4-userspace-netdiag.service "$pkgdir/usr/lib/systemd/system/pico4-userspace-netdiag.service"
  install -Dm755 msm-frame-stats "$pkgdir/usr/libexec/pico4/msm-frame-stats"
  install -Dm755 session-performance "$pkgdir/usr/libexec/pico4/session-performance"
  install -Dm755 userspace-netdiag "$pkgdir/usr/libexec/pico4/userspace-netdiag"
  install -Dm644 50-pico4-checks.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
