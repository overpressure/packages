+
+void
+CServerDriver_Monado::SetFloorDetection(bool on)
+{
+	if (on == m_floor_detection || pico4_hmd_floor == NULL) {
+		return;
+	}
+	if (m_server_internal == nullptr) {
+		vr::EVRInitError err = vr::VRInitError_None;
+		m_server_internal = vr::VRDriverContext()->GetGenericInterface("IVRServerInternal_XXX", &err);
+		m_floor_paths = (IVRPaths001 *)vr::VRDriverContext()->GetGenericInterface("IVRPaths_001", &err);
+		if (m_floor_paths != nullptr) {
+			m_floor_paths->StringToHandle(&m_room_setup_transform, "/chaperone/room_setup/transform");
+		}
+		if (m_server_internal == nullptr || m_floor_paths == nullptr) {
+			ovrd_log("Room setup: no floor detection (server %p, paths %p)\n", m_server_internal,
+			         (void *)m_floor_paths);
+			return;
+		}
+	}
+	m_floor_detection = on;
+	ovrd_log("Room setup: floor detection %s\n", on ? "on" : "off");
+	if (on && pico4_hmd_detect_floor != NULL && m_xhmd != NULL) {
+		pico4_hmd_detect_floor(m_xhmd);
+	}
+	if (!on) {
+		SendFloor(NAN);
+	}
+	m_floor_sent = NAN;
+}
+
+void
+CServerDriver_Monado::SendFloor(float y)
+{
+	using floor_fn = void (*)(void *self, float y);
+	void **vtable = *(void ***)m_server_internal;
+	((floor_fn)vtable[kFloorDetectionSlot])(m_server_internal, y);
+}
+
+//! While detection is on: each new floor height, through the room setup's transform as driver_cv.
+void
+CServerDriver_Monado::UpdateFloor()
+{
+	float y;
+	if (!m_floor_detection || m_xhmd == NULL || !pico4_hmd_floor(m_xhmd, &y) ||
+	    fabsf(y - m_floor_sent) < 0.001f) {
+		return;
+	}
+	vr::HmdMatrix34_t m;
+	PathRead001 read = {m_room_setup_transform, &m, sizeof(m), 0, 0, 0, nullptr};
+	if (m_floor_paths->ReadPathBatch(kChaperoneRoot, &read, 1) != 0 || read.error != 0 ||
+	    read.tag != vr::k_unHmdMatrix34PropertyTag) {
+		return;
+	}
+	const float y_setup = m.m[1][1] * y + m.m[1][3];
+	SendFloor(y_setup);
+	if (std::isnan(m_floor_sent)) {
+		ovrd_log("Room setup: the detected floor at %.3f m (raw), %.3f m in the room setup\n", y, y_setup);
+	}
+	m_floor_sent = y;
 }
 
 
