{
  "jsonid": "input_profile",
  "controller_type": "pico_controller",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "steamvr-monado",
  "driver_name": "monado",
  "remapping": "input/default_pico_controller_remapping.json",
  "input_bindingui_mode": "controller_handed",
  "input_bindingui_left": {"image": "{indexcontroller}/icons/indexcontroller_left.svg"},
  "input_bindingui_right": {"image": "{indexcontroller}/icons/indexcontroller_right.svg"},
  "should_show_binding_errors": true,
  "input_source": {
    "/input/system": {"type": "button", "click": true, "binding_image_point": [0, 0], "order": 0},
    "/input/trigger": {"type": "trigger", "value": true, "click": true, "touch": true, "binding_image_point": [0, 0], "order": 1},
    "/input/joystick": {"type": "joystick", "click": true, "touch": true, "binding_image_point": [0, 0], "order": 2},
    "/input/grip": {"type": "trigger", "value": true, "click": true, "binding_image_point": [0, 0], "order": 3},
    "/input/a": {"type": "button", "side": "right", "click": true, "touch": true, "binding_image_point": [0, 0], "order": 4},
    "/input/b": {"type": "button", "side": "right", "click": true, "touch": true, "binding_image_point": [0, 0], "order": 5},
    "/input/x": {"type": "button", "side": "left", "click": true, "touch": true, "binding_image_point": [0, 0], "order": 4},
    "/input/y": {"type": "button", "side": "left", "click": true, "touch": true, "binding_image_point": [0, 0], "order": 5},
    "/output/haptic": {"type": "vibration", "binding_image_point": [0, 0]},
    "/pose/raw": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/tip": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/aim": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/handgrip": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/grip": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/openxr_aim": {"type": "pose", "binding_image_point": [0, 0]},
    "/pose/openxr_grip": {"type": "pose", "binding_image_point": [0, 0]}
  },
  "default_bindings": [
    {"app_key": "openvr.component.vrcompositor", "binding_url": "pico4_vrcompositor_bindings.json"},
    {"app_key": "vrlink.client", "binding_url": "pico4_vrlink_bindings.json"}
  ]
}
