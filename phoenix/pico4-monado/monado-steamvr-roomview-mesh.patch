+		void *buffer = nullptr;
+		if (m_queues->AcquireWriteOnlyBlock(m_mesh_queue[0], &block, &buffer) != 0 || buffer == nullptr) {
+			return false;
+		}
+		memcpy(buffer, vertices.data(), (size_t)info.vertex_count * 3 * sizeof(float));
+		vr::HmdMatrix34_t raw_from_mesh;
+		for (int r = 0; r < 3; r++) {
