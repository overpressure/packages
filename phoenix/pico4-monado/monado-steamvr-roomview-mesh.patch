+	//! Typed values under paths on @p root (a queue or a block); false if any was refused.
+	bool
+	WritePaths(vr::PropertyContainerHandle_t root, PathWrite001 *batch, uint32_t count)
+	{
+		for (uint32_t i = 0; i < count; i++) {
+			m_paths->StringToHandle(&batch[i].path, batch[i].name);
+		}
+		int r = m_paths->WritePathBatch(root, batch, count);
+		bool ok = r == 0;
+		for (uint32_t i = 0; i < count; i++) {
+			ok = ok && batch[i].error == 0 && batch[i].set_error == 0;
+		}
+		if (!ok && !m_mesh_error_logged) {
+			m_mesh_error_logged = true;
+			for (uint32_t i = 0; i < count; i++) {
+				ovrd_log("Camera: depth mesh: %s: batch %d, error %d/%d\n", batch[i].name, r, batch[i].error,
+				         batch[i].set_error);
+			}
+		}
+		return ok;
+	}
+
+	//! A CLOCK_MONOTONIC time on the compositor's clock: CLOCK_MONOTONIC_RAW seconds.
+	static double
+	CompositorSeconds(int64_t monotonic_ns)
+	{
+		struct timespec raw;
+		clock_gettime(CLOCK_MONOTONIC_RAW, &raw);
+		return raw.tv_sec + raw.tv_nsec / 1e9 - (double)(os_monotonic_get_ns() - monotonic_ns) / 1e9;
+	}
+
+	//! The triangles of layout @p id: the compositor keeps them until a new layoutId.
+	bool
