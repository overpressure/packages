+	/*!
+	 * Each new depth mesh: the driver hands them over while the room view shows the cameras (it
+	 * asks for frames), and asking is what keeps pico4-slamd making them, so otherwise its depth
+	 * pipeline idles. A new layoutId only when the triangles change (PICO OS's hemisphere keeps
+	 * them), each mesh once, as the Frame's XR service publishes its own.
+	 */
+	void
+	MeshRun()
+	{
+		std::vector<float> vertices(PICO4_DEPTH_MESH_VERTICES * 3);
+		std::vector<uint32_t> indices(PICO4_DEPTH_MESH_INDICES), layout;
+		struct pico4_depth_mesh_info info = {}, next;
+		uint64_t layout_id = 0, published = 0;
+		while (m_meshing) {
+			// A failed copy may leave a partial mesh in its buffers; the next mesh replaces it.
+			if (!pico4_hmd_depth_mesh(m_xdev, info.id, vertices.data(), indices.data(), &next)) {
+				std::this_thread::sleep_for(std::chrono::milliseconds(2));
+				continue;
+			}
+			info = next;
+			if (layout_id == 0 || layout.size() != info.index_count ||
+			    memcmp(layout.data(), indices.data(), layout.size() * sizeof(uint32_t)) != 0) {
+				layout.assign(indices.begin(), indices.begin() + info.index_count);
+				layout_id++;
+				if (!WriteLayout(layout_id, (int32_t)info.vertex_count, layout)) {
+					layout.clear();
+					continue;
+				}
+			}
+			if (!WriteMesh(info, vertices, layout_id)) {
+				continue;
+			}
+			if (published++ % 250 == 0) {
+				ovrd_log("Camera: depth mesh %llu published: %u vertices, %u triangles, layout %llu\n",
+				         (unsigned long long)info.id, info.vertex_count, info.index_count / 3,
+				         (unsigned long long)layout_id);
+			}
+		}
+	}
