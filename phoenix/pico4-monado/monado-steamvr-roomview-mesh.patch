+	{
+		vr::PropertyContainerHandle_t block = 0;
+		void *buffer = nullptr;
+		if (m_queues->AcquireWriteOnlyBlock(m_mesh_queue[1], &block, &buffer) != 0 || buffer == nullptr) {
+			return false;
+		}
+		memcpy(buffer, indices.data(), indices.size() * sizeof(uint32_t));
+		const int32_t index_count = (int32_t)indices.size();
+		PathWrite001 batch[3] = {
+		    {0, 0, 0, &id, sizeof(id), vr::k_unUint64PropertyTag, 0, "/meshLayout/layoutId"},
+		    {0, 0, 0, &vertex_count, sizeof(vertex_count), vr::k_unInt32PropertyTag, 0, "/meshLayout/vertexCount"},
+		    {0, 0, 0, &index_count, sizeof(index_count), vr::k_unInt32PropertyTag, 0, "/meshLayout/indexCount"},
+		};
+		bool ok = WritePaths(block, batch, 3);
+		m_queues->ReleaseWriteOnlyBlock(m_mesh_queue[1], block);
+		return ok;
+	}
