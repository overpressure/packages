# SPDX-License-Identifier: Unlicense
# pico4-onboarding's own texts, by the Steam client's language names (docs/session.md#first-run-setup).
# English is the reference; the other languages are machine-assisted translations awaiting a native
# speaker's review. Everything the client has words for (language and zone names, Wi-Fi, the buttons
# Next, Back, Done, Continue, Connect, Refresh) comes from its own files at runtime instead.
# "\n" breaks a line; %s is filled in, in order.

[english]
setup_welcome = Let's set up your PICO 4: language, time zone, Wi-Fi, controllers and lenses.
setup_welcome_point = Point a controller at Continue and pull its trigger.
setup_language_note = Steam starts in this language.
setup_timezone_note = The headset's clock and Steam use this time zone.
