+/*!
+ * After a move of the lenses, at most once a second: SteamVR's eye positions and its IPD, which
+ * were set once in Activate.
+ */
+void
+CDeviceDriver_Monado::UpdateIpd(std::chrono::steady_clock::time_point *next)
+{
+	auto now = std::chrono::steady_clock::now();
+	float ipd;
+	if (now < *next || pico4_hmd_ipd == NULL) {
+		return;
+	}
+	*next = now + std::chrono::seconds(1);
+	if (!pico4_hmd_ipd(m_xdev, &ipd) || std::abs(ipd - m_flIPD) < 0.0001f) {
+		return;
+	}
+	struct xrt_vec3 ipd_vec = {ipd, 0, 0};
+	struct xrt_space_relation head_relation;
+	struct xrt_fov fovs[2];
+	xrt_device_get_view_poses(m_xdev, &ipd_vec, os_monotonic_get_ns(), XRT_VIEW_TYPE_STEREO, 2, &head_relation,
+	                          fovs, m_view_pose);
+	m_flIPD = -m_view_pose[0].position.x + m_view_pose[1].position.x;
+	vr::HmdMatrix34_t left;
+	create_translation_rotation_matrix(&m_view_pose[0], &left);
+	vr::HmdMatrix34_t right;
+	create_translation_rotation_matrix(&m_view_pose[1], &right);
+	vr::VRServerDriverHost()->SetDisplayEyeToHead(m_trackedDeviceIndex, left, right);
+	vr::VRProperties()->SetFloatProperty(m_ulPropertyContainer, vr::Prop_UserIpdMeters_Float, m_flIPD);
+	ovrd_log("IPD: %f\n", m_flIPD);
+}
