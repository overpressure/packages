{
  "action_manifest_version": 0,
  "app_key": "vrlink.client",
  "category": "legacy",
  "controller_type": "pico_controller",
  "name": "Steam Link client bindings for the PICO 4 controllers",
  "description": "A binding of its own for SteamVR's Steam Link client, so that SteamVR does not remap it to the Index controllers and simulate an Index headset: the client sends the PC the headset it finds. Poses, haptics and inputs on the client's legacy actions, as the Frame controller's: X and Y on its left pad's down and up, B on its right B.",
  "options": {},
  "simulated_actions": [],
  "alias_info": {},
  "bindings": {
    "/actions/legacy": {
      "poses": [
        {
          "output": "/actions/legacy/in/Left_Pose",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/legacy/in/Right_Pose",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "haptics": [
        {
          "output": "/actions/legacy/out/left_haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/legacy/out/right_haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/left_system_press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/legacy/in/left_axis2_value1"
            },
            "touch": {
              "output": "/actions/legacy/in/head_proximity"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/legacy/in/left_axis1_value"
            },
            "click": {
              "output": "/actions/legacy/in/left_grip_press"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/left_axis0_press"
            },
            "touch": {
              "output": "/actions/legacy/in/left_axis0_touch"
            },
            "position": {
              "output": "/actions/legacy/in/left_axis0_value"
            }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/right_system_press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/legacy/in/right_axis2_value1"
            },
            "touch": {
              "output": "/actions/legacy/in/head_proximity"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "pull": {
              "output": "/actions/legacy/in/right_axis1_value"
            },
            "click": {
              "output": "/actions/legacy/in/right_grip_press"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/right_axis0_press"
            },
            "touch": {
              "output": "/actions/legacy/in/right_axis0_touch"
            },
            "position": {
              "output": "/actions/legacy/in/right_axis0_value"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/left_a_press"
            },
            "touch": {
              "output": "/actions/legacy/in/left_a_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/left_axis3_press"
            },
            "touch": {
              "output": "/actions/legacy/in/left_axis3_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/right_a_press"
            },
            "touch": {
              "output": "/actions/legacy/in/right_a_touch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/legacy/in/right_axis2_press"
            },
            "touch": {
              "output": "/actions/legacy/in/right_axis2_touch"
            }
          }
        }
      ]
    }
  }
}
