+/*!
+ * The PICO 4's exact inverse (its lens model is radial). Without it SteamVR inverts
+ * ComputeDistortion numerically for its Facet renderer, which fails at the border of
+ * the field of view: stretched triangles there flicker during head turns. Other
+ * devices return false, and SteamVR inverts numerically as before.
+ */
+bool
+CDeviceDriver_Monado::ComputeInverseDistortion(
+    vr::HmdVector2_t *pResult, vr::EVREye eEye, uint32_t unChannel, float fU, float fV)
+{
+	struct xrt_vec2 *rot = m_xdev->hmd->views[eEye].rot.vecs;
+	if (rot[0].x != 1 || rot[0].y != 0 || rot[1].x != 0 || rot[1].y != 1) {
+		return false; // ComputeDistortion rotates its input first; only the unrotated case here
+	}
+	float u, v;
+	if (pico4_hmd_compute_inverse_distortion == NULL ||
+	    !pico4_hmd_compute_inverse_distortion(m_xdev, eEye, unChannel, fU, fV, &u, &v)) {
+		return false;
+	}
+	pResult->v[0] = u;
+	pResult->v[1] = v;
+	return true;
+}
