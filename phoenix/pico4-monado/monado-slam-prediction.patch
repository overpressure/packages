+//! The newest SLAM pose, at the time of its images, without prediction or filtering.
+extern "C" bool
+t_slam_get_latest_pose(struct xrt_tracked_slam *xts, int64_t *out_ts_ns, struct xrt_space_relation *out_relation)
+{
+	auto &t = *container_of(xts, TrackerSlam, base);
+	flush_poses(t);
+	return t.slam_rels.get_latest(out_ts_ns, out_relation);
+}
+
+//! Asks the SLAM system to start a new map, as the debug UI's reset button does.
+extern "C" void
+t_slam_reset(struct xrt_tracked_slam *xts)
+{
+	auto &t = *container_of(xts, TrackerSlam, base);
+	if (t.vit.tracker_reset(t.tracker) != VIT_SUCCESS) {
+		SLAM_WARN("Failed to reset VIT tracker");
 	}
 }
 
