# PICO OS's shutdown at a low or hot battery (docs/cooling.md#hardware-limits): a clean power-off
# below 1 %, at 4 % or less with the screen off unless the headset is charging, and above 59.0 °C.
[Unit]
Description=PICO 4 power-off at a low or hot battery
ConditionPathExists=/sys/class/power_supply/battery

[Service]
ExecStart=/usr/libexec/pico4/battery-guard
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
