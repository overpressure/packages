# The power key as on PICO OS (docs/install.md#power-key): a short press suspends, a 2 s hold
# powers off. logind ignores the key (logind.conf.d/50-pico4-power-key.conf).
[Unit]
Description=PICO 4 power key
After=systemd-logind.service

[Service]
ExecStart=/usr/libexec/pico4/powerkey
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
