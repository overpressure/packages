# The PICO 4's sound as on PICO OS: the audio DSP and its audio process's file server, the LPASS macros,
# the sound card's UCM routes, PipeWire's and WirePlumber's settings for it, the calibration tool
# (pico4-audiocal; the image's build exports PICO OS's calibration with it) and the microphone muted while
# the headset is off the head. The preset enables the audio target; the tests run in the build.
pkgname=pico4-audio
pkgver=1
pkgrel=1
pkgdesc="PICO 4 audio: the ADSP, its audio process, the sound card's routes and calibration, the microphone mute"
arch=(any)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/pipewire/pipewire.conf.d/51-pico4-quantum.conf
        etc/wireplumber/wireplumber.conf.d/51-pico4-sound-card.conf)
source=(51-pico4-quantum.conf
        51-pico4-sound-card.conf
        pico4-audiocal
        pico4-adsp.service
        pico4-audio.target
        pico4-audiopd.service
        pico4-lpass-macros.service
        pico4-micmute.service
        51-pico4-micmute.conf
        audiopd
        lpass-macros
        micmute
        PICO4-HiFi.conf
        PICO4.conf
        50-pico4-audio.preset
        test_audiocal.py test_micmute.py)
sha256sums=('5789e02ea04b1a1100faabd0805891703a8916d00be1ff90f428c16db831308f'
