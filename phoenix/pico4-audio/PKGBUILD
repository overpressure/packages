build() {
  python3 -B -m unittest test_audiocal test_micmute
}

package() {
  install -Dm644 51-pico4-quantum.conf "$pkgdir/etc/pipewire/pipewire.conf.d/51-pico4-quantum.conf"
  install -Dm644 51-pico4-sound-card.conf "$pkgdir/etc/wireplumber/wireplumber.conf.d/51-pico4-sound-card.conf"
  install -Dm755 pico4-audiocal "$pkgdir/usr/bin/pico4-audiocal"
  install -Dm644 pico4-adsp.service "$pkgdir/usr/lib/systemd/system/pico4-adsp.service"
  install -Dm644 pico4-audio.target "$pkgdir/usr/lib/systemd/system/pico4-audio.target"
  install -Dm644 pico4-audiopd.service "$pkgdir/usr/lib/systemd/system/pico4-audiopd.service"
  install -Dm644 pico4-lpass-macros.service "$pkgdir/usr/lib/systemd/system/pico4-lpass-macros.service"
  install -Dm644 pico4-micmute.service "$pkgdir/usr/lib/systemd/user/pico4-micmute.service"
  install -Dm644 51-pico4-micmute.conf "$pkgdir/usr/lib/systemd/user/steamvr.service.d/51-pico4-micmute.conf"
  install -Dm755 audiopd "$pkgdir/usr/libexec/pico4/audiopd"
  install -Dm755 lpass-macros "$pkgdir/usr/libexec/pico4/lpass-macros"
  install -Dm755 micmute "$pkgdir/usr/libexec/pico4/micmute"
  install -Dm644 PICO4-HiFi.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/PICO4-HiFi.conf"
  install -Dm644 PICO4.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/PICO4.conf"
  install -Dm644 50-pico4-audio.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
