"""What listens on the network beyond loopback, and what of it is not expected (docs/security.md).

pico4-listeners          every listener, one per line; exit status 1 on an unexpected one
pico4-listeners --json   the same as JSON, for pico4-userspace-check
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from typing import TypedDict

#: Who may listen beyond loopback, by process name, and on what. None: any port.
EXPECTED = {
    "sshd": {("tcp", 22)},  # keys only (sshd_config.d/50-pico4.conf)
    "systemd-network": {("udp", 67), ("udp", 68), ("udp", 546)},  # the USB link's DHCP, the client's
    "NetworkManager": {("udp", 68), ("udp", 546)},  # the Wi-Fi's DHCP client
    "systemd-resolve": {("tcp", 5355), ("udp", 5355), ("udp", 5353)},  # name resolution
    "systemd-timesyn": None,  # its NTP socket
    # Steam's own: its local network discovery, Remote Play and Steam Link streaming.
    "steam": None,
    "steamwebhelper": None,
    "vrlink": None,
    "vrserver": None,
}
LOOPBACK = re.compile(r"^(127\.|\[::1\]|::1|\[::ffff:127\.)")
_LINE = re.compile(
    r"^(?P<proto>tcp|udp)\s+\S+\s+\d+\s+\d+\s+(?P<local>\S+)\s+\S+(?:\s+users:\(\(\"(?P<name>[^\"]+)\")?"
)


class Listener(TypedDict):
    """One socket listening beyond loopback, as ss reports it."""

    proto: str
    address: str
    port: int
    process: str


def parse(text: str) -> list[Listener]:
    """Return the non-loopback listeners in the output of ss -H -lntup."""
    found: list[Listener] = []
    for line in text.splitlines():
        match = _LINE.match(line.strip())
        if not match:
            continue
        address, _, port = match["local"].rpartition(":")
        if LOOPBACK.match(address) or not port.isdigit():
            continue
        found.append(Listener(proto=match["proto"], address=address, port=int(port), process=match["name"] or "?"))
    return found


def unexpected(listeners: list[Listener]) -> list[Listener]:
    """Return the listeners no entry of EXPECTED allows."""
    bad: list[Listener] = []
    for item in listeners:
        allowed = EXPECTED.get(item["process"], ())
        if allowed is not None and (item["proto"], item["port"]) not in allowed:
            bad.append(item)
    return bad


def describe(item: Listener) -> str:
    """Name one listener in a line for people."""
    return f"{item['process']} {item['proto']}/{item['port']} on {item['address']}"


def main(argv: list[str]) -> int:
    """Print the listeners (or JSON with --json); exit status 1 on an unexpected one."""
    text = subprocess.run(
        ["ss", "-H", "-lntup"],  # noqa: S607  # iproute2's ss from the system PATH
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout
    listeners = parse(text)
    bad = unexpected(listeners)
    if "--json" in argv:
        print(json.dumps({"listeners": listeners, "unexpected": [describe(item) for item in bad]}))
    else:
        for item in listeners:
            print(("UNEXPECTED " if item in bad else "") + describe(item))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
