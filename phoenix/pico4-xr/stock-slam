#!/bin/bash
# SPDX-License-Identifier: Unlicense
# Run a program of PICO OS's head tracker in its bionic root (docs/xr.md#head-tracking):
# /usr/lib/pico4-stock-slam holds PICO OS's bionic linker and libraries, the tracker, its DSP
# modules and configuration (python -m overpressure assets) and this project's pico4-slamd. It
# runs in a private mount namespace, chrooted, with /dev, /proc and /sys bound in, the factory
# calibration where PICO OS keeps it (/mnt/vendor/persist/pvr and /mnt/vendor/pvr) and /data and
# /tmp as tmpfs; the mounts vanish with the process. The tracker's maps and boundary, which PICO OS
# keeps in /data/misc/user/0, and the camera modules' ids, which its station service keeps in
# /data/stationservice, come from /var/lib/pico4-stock-slam (the data partition): a known room
# relocalises in the next session, and the ids are read from the modules only once.
#
#   stock-slam [--vendor] PROGRAM [ARGS...]   (PROGRAM's path in the root)
#
# --vendor puts the vendor libraries first (the DSP's root listener, cdsprpcd). The root has no
# Android runtime: programs start through bionic's bootstrap linker.
# The FastRPC bridge is preloaded as well: it carries the stock libraries' vendor FastRPC and ION
# calls over to the upstream driver and the DMA-BUF heap (src/stockslam/fastrpc_bridge.h).
set -euo pipefail
root=/usr/lib/pico4-stock-slam
calibration=/usr/share/qcom/pico4/calibration/pvr
state=/var/lib/pico4-stock-slam
# shellcheck disable=SC2174 # only the leaf folders are private; $state itself stays as it is
mkdir -p -m 0700 "$state/maps" "$state/boundary" "$state/stationservice"
# A leftover localmode would switch relocalisation off; stsdata (see-through type) is not ours.
rm -f "$state/boundary/localmode" "$state/boundary/stsdata.txt"
libs=/system/lib64/bootstrap:/system/lib64
[ "${1:-}" = --vendor ] && { libs=/vendor/lib64:$libs; shift; }
[ -x "$root/system/bin/bootstrap/linker64" ] || { echo "stock-slam: no tracker root in $root" >&2; exit 1; }
[ -d "$calibration/mav0" ] || { echo "stock-slam: no factory calibration in $calibration" >&2; exit 1; }
preload=/pico4/libpico4-slam-stubs.so:/pico4/libpico4-fastrpc-bridge.so
exec unshare -m --propagation private /bin/bash -c '
	set -e
	root=$1 calibration=$2 libs=$3 state=$4 preload=$5
	shift 5
	mount --rbind /dev "$root/dev"
	mount -t proc proc "$root/proc"
	mount --rbind /sys "$root/sys"
	mount -t tmpfs -o mode=0755 tmpfs "$root/data"
	mount -t tmpfs tmpfs "$root/tmp"
	mount --bind "$calibration" "$root/mnt/vendor/persist/pvr"
	mount --bind "$calibration" "$root/mnt/vendor/pvr"
	mkdir -p "$root/data/local/tmp" "$root/data/misc/user/0/maps" "$root/data/misc/user/0/boundary" \
		"$root/data/stationservice"
	mount --bind "$state/maps" "$root/data/misc/user/0/maps"
	mount --bind "$state/boundary" "$root/data/misc/user/0/boundary"
	mount --bind "$state/stationservice" "$root/data/stationservice"
	exec env -i PATH=/system/bin LD_LIBRARY_PATH="$libs" LD_PRELOAD="$preload" \
		"ADSP_LIBRARY_PATH=/vendor/lib/rfsa/adsp;/vendor/dsp/cdsp" \
		${PICO4_SLAMD_DEBUG:+PICO4_SLAMD_DEBUG=$PICO4_SLAMD_DEBUG} ${PICO4_SLAMD_LSC:+PICO4_SLAMD_LSC=$PICO4_SLAMD_LSC} \
		${PICO4_SLAMD_AE:+PICO4_SLAMD_AE=$PICO4_SLAMD_AE} ${PICO4_SLAMD_RESTART_S:+PICO4_SLAMD_RESTART_S=$PICO4_SLAMD_RESTART_S} \
		${PICO4_SLAMD_RELOCALISE_S:+PICO4_SLAMD_RELOCALISE_S=$PICO4_SLAMD_RELOCALISE_S} \
		/usr/bin/chroot "$root" /system/bin/bootstrap/linker64 "$@"
' stock-slam "$root" "$calibration" "$libs" "$state" "$preload" "$@"
