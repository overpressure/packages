build() {
  python3 -B -m unittest test_imu test_imu_wait test_lens_tool test_station_tool test_listeners_still_gate
}

package() {
  install -Dm644 60-persistent-v4l.rules "$pkgdir/etc/udev/rules.d/60-persistent-v4l.rules"
  install -Dm644 50-pico4-no-cameras.conf "$pkgdir/etc/wireplumber/wireplumber.conf.d/50-pico4-no-cameras.conf"
  install -Dm755 pico4-imu "$pkgdir/usr/bin/pico4-imu"
  install -Dm755 pico4-lens "$pkgdir/usr/bin/pico4-lens"
  install -Dm755 pico4-listeners "$pkgdir/usr/bin/pico4-listeners"
  install -Dm755 pico4-station "$pkgdir/usr/bin/pico4-station"
  install -Dm755 pico4-still-gate "$pkgdir/usr/bin/pico4-still-gate"
  install -Dm644 pico4-cdsp.service "$pkgdir/usr/lib/systemd/system/pico4-cdsp.service"
  install -Dm644 pico4-cdsprpcd.service "$pkgdir/usr/lib/systemd/system/pico4-cdsprpcd.service"
  install -Dm644 pico4-imu-ready.service "$pkgdir/usr/lib/systemd/system/pico4-imu-ready.service"
  install -Dm644 pico4-sensors.target "$pkgdir/usr/lib/systemd/system/pico4-sensors.target"
  install -Dm644 pico4-sensorspd.service "$pkgdir/usr/lib/systemd/system/pico4-sensorspd.service"
  install -Dm644 pico4-slamd.service "$pkgdir/usr/lib/systemd/system/pico4-slamd.service"
  install -Dm644 pico4-slpi.service "$pkgdir/usr/lib/systemd/system/pico4-slpi.service"
  install -Dm644 70-pico4-xr.rules "$pkgdir/usr/lib/udev/rules.d/70-pico4-xr.rules"
  install -Dm755 sensorspd "$pkgdir/usr/libexec/pico4/sensorspd"
  install -Dm755 stock-slam "$pkgdir/usr/libexec/pico4/stock-slam"
  install -Dm644 50-pico4-xr.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
