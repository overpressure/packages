# The PICO 4's XR hardware around Monado's driver: the sensor DSP (SLPI) and its sensors process's file
# server, the head IMU's readiness, the Compute DSP and PICO OS's head tracker's services (pico4-slamd itself
# is built by the image's build from PICO OS's files), the device tools (pico4-imu, pico4-station, pico4-lens,
# pico4-listeners, pico4-still-gate), the XR devices' permissions and the cameras kept from v4l_id and
# WirePlumber. The preset enables the sensors; the tests run in the build.
pkgname=pico4-xr
pkgver=1
pkgrel=1
pkgdesc="PICO 4 XR hardware: the sensor and compute DSPs, the head IMU, the station, lenses and cameras"
arch=(any)
url="https://github.com/overpressure/overpressure/tree/main/devices/phoenix/docs"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/udev/rules.d/60-persistent-v4l.rules
        etc/wireplumber/wireplumber.conf.d/50-pico4-no-cameras.conf)
source=(60-persistent-v4l.rules
        50-pico4-no-cameras.conf
        pico4-imu
        pico4-lens
        pico4-listeners
        pico4-station
        pico4-still-gate
        pico4-cdsp.service
        pico4-cdsprpcd.service
        pico4-imu-ready.service
        pico4-sensors.target
        pico4-sensorspd.service
        pico4-slamd.service
        pico4-slpi.service
        70-pico4-xr.rules
        sensorspd
        stock-slam
        50-pico4-xr.preset
        test_imu.py test_imu_wait.py test_lens_tool.py test_station_tool.py test_listeners_still_gate.py)
