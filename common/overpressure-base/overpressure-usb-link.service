# The USB link to the PC: network and serial function (overpressure's docs/runtime.md). The Frame's
# own gadget units stay masked; this gadget is the one the maintenance system sets up too.
[Unit]
Description=USB link to the PC
DefaultDependencies=no
Wants=sys-kernel-config.mount
After=sys-kernel-config.mount systemd-tmpfiles-setup-dev.service
Before=sysinit.target network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/overpressure/usb-link

[Install]
WantedBy=sysinit.target
