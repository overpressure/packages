build() {
  python3 -B -m unittest test_config test_usb_internet
  bash test_boot_attempts.sh
  bash test_steamos_readonly.sh
}

package() {
  install -Dm644 50-overpressure-usb.conf "$pkgdir/etc/NetworkManager/conf.d/50-overpressure-usb.conf"
  install -Dm644 sshd_config.d-50-overpressure.conf "$pkgdir/etc/ssh/sshd_config.d/50-overpressure.conf"
  # The CJK face of the text's language, and Noto Sans Arabic, where fontconfig's generic
  # families would otherwise take the Japanese and Urdu faces.
  install -Dm644 67-overpressure-language-fonts.conf "$pkgdir/etc/fonts/conf.d/67-overpressure-language-fonts.conf"
  install -Dm644 home.mount "$pkgdir/etc/systemd/system/home.mount"
  install -Dm644 journald.conf.d-50-overpressure.conf "$pkgdir/usr/lib/systemd/journald.conf.d/50-overpressure.conf"
  install -Dm644 50-overpressure-usb.network "$pkgdir/usr/lib/systemd/network/50-overpressure-usb.network"
  install -Dm644 system.conf.d-50-overpressure.conf "$pkgdir/usr/lib/systemd/system.conf.d/50-overpressure.conf"
  install -Dm644 emergency.service.d-overpressure.conf "$pkgdir/usr/lib/systemd/system/emergency.service.d/overpressure.conf"
  install -Dm644 rescue.service.d-overpressure.conf "$pkgdir/usr/lib/systemd/system/rescue.service.d/overpressure.conf"
  local unit
  for unit in boot-ok recovery-watch storage-ro usb-link usb-internet; do
    install -Dm644 "overpressure-$unit.service" "$pkgdir/usr/lib/systemd/system/overpressure-$unit.service"
  done
  install -Dm644 overpressure-usb-link.conf "$pkgdir/usr/lib/tmpfiles.d/overpressure-usb-link.conf"
  install -Dm644 00-overpressure-devnodes.rules "$pkgdir/usr/lib/udev/rules.d/00-overpressure-devnodes.rules"
  local program
  for program in boot-attempts devnode fail-to-fastboot preinit usb-link usb-internet; do
    install -Dm755 "$program" "$pkgdir/usr/libexec/overpressure/$program"
  done
  # Valve's /usr/bin/steamos-readonly handles btrfs only: the image build links it to this one.
  install -Dm755 steamos-readonly "$pkgdir/usr/libexec/overpressure/steamos-readonly"
  # The headset's preinit hooks (preinit's header).
  install -dm755 "$pkgdir/usr/lib/overpressure/preinit/early.d" "$pkgdir/usr/lib/overpressure/preinit/mounted.d"
  install -Dm644 50-overpressure-base.preset -t "$pkgdir/usr/lib/systemd/system-preset"
}
