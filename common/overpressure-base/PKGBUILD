# The installed system's share of overpressure's headset runtime (overpressure's docs/runtime.md), on any headset:
# preinit (the first process: storage policy, boot count, data partition, the headset's hooks), the read-only
# storage policy and the recovery deadline, the USB link to the PC (gadget, network, the PC as a last-resort
# gateway), steamos-readonly for an ext4 image, emergency and rescue back to the bootloader, and the system's
# generic policy files. Its programs source the runtime's lib.sh, and the recovery deadline runs the runtime's
# recovery-watch: the image build installs both from overpressure, as the maintenance system has them, with the
# headset's values in /etc/overpressure/headset. The preset enables the services; the tests run in the build.
pkgname=overpressure-base
pkgver=2026.11.25
pkgrel=1
pkgdesc="overpressure's installed system: preinit, storage and recovery policy, USB link"
arch=(any)
url="https://github.com/overpressure/overpressure/blob/main/docs/runtime.md"
license=(Unlicense)
depends=(bash python systemd)
backup=(etc/NetworkManager/conf.d/50-overpressure-usb.conf
        etc/ssh/sshd_config.d/50-overpressure.conf
        etc/systemd/system/home.mount
        etc/fonts/conf.d/67-overpressure-language-fonts.conf)
source=(50-overpressure-usb.conf
        sshd_config.d-50-overpressure.conf
        home.mount
        journald.conf.d-50-overpressure.conf
        50-overpressure-usb.network
        system.conf.d-50-overpressure.conf
        emergency.service.d-overpressure.conf
        rescue.service.d-overpressure.conf
        overpressure-boot-ok.service
        overpressure-recovery-watch.service
        overpressure-storage-ro.service
        overpressure-usb-link.service
        overpressure-usb-internet.service
        overpressure-usb-link.conf
        00-overpressure-devnodes.rules
        boot-attempts
        devnode
        fail-to-fastboot
        preinit
        steamos-readonly
        usb-link
        usb-internet
        test_config.py test_usb_internet.py
        test_boot_attempts.sh test_steamos_readonly.sh
        50-overpressure-base.preset
        67-overpressure-language-fonts.conf)
sha256sums=('952324c99b08f87f6d318258eb24915ed4f18a4f9fa219e756bbca70d5bd8396'
