#!/bin/bash
# SPDX-License-Identifier: Unlicense
# SteamOS's steamos-readonly for the installed system's image (overpressure's docs/runtime.md):
# the same commands, messages, exit codes and /.ROOTFS_RW marker as SteamOS's, for an ext4 image in super
# that is read-only both as a mount and as a block device. SteamOS keeps the setting in its btrfs root's ro
# property; here it is a file in the image, /.overpressure-writable, which preinit and the storage policy (devnode)
# read at every boot. An upgrade writes a fresh image without it, so the system is read-only again afterwards
# and whatever was installed meanwhile is gone, as after a SteamOS update.
#
#   steamos-readonly disable   the root and super writable, now and at every boot until enable; the file
#                              system grows to the whole partition
#   steamos-readonly enable    synced, then the root and super read-only again
#   steamos-readonly status    enabled (exit 0) or disabled (exit 1)
#   steamos-readonly toggle    the other one, then the status
set -euo pipefail

# The setting (the image's own, so a fresh image starts read-only) and SteamOS's marker of a toggled root.
WRITABLE=/.overpressure-writable
MARKER=/.ROOTFS_RW

usage() {
    cat <<EOF
Usage: ${0##*/} enable|disable|status

Enable or disable read-only on the current running SteamOS.
EOF
}

needs_root() {
    if [[ "$(id -u)" -ne 0 ]]; then
        echo "$(basename "$0") needs to be run as root"
        exit 1
    fi
}

# The root's block device (super) and the disk it is on.
root_device() { findmnt -fno SOURCE /; }
disk_of() { basename "$(readlink -f "/sys/class/block/$(basename "$1")/..")"; }

status() {
    if [[ -e $WRITABLE ]]; then
        echo "disabled"
        return 1
    fi
    echo "enabled"
    return 0
}

read_write() {
    if ! status >/dev/null; then
        echo "Warning: The rootfs is already read-write!" >&2
        echo "         Nothing is performed." >&2
        return
    fi
    needs_root
    local dev disk
    dev=$(root_device)
    blockdev --setrw "$dev"
    # The kernel counts a disk's read-only flag for its partitions too; the data partition's disk, which
    # holds super, is writable already, and its other partitions keep their own flags.
    disk=$(disk_of "$dev")
    [[ $(cat "/sys/class/block/$disk/ro") == 0 ]] || blockdev --setrw "/dev/$disk"
    mount -o remount,rw /
    # The image has room for its contents only: from now on the whole partition (online).
    resize2fs "$dev" >/dev/null 2>&1 || echo "Warning: could not grow the file system to the whole partition." >&2
    date > "$MARKER"
    touch "$WRITABLE"
    sync /
}

read_only() {
    if status >/dev/null; then
        echo "Warning: The rootfs is already read-only!" >&2
        echo "         Nothing is performed." >&2
        return
    fi
    needs_root
    rm -f "$WRITABLE"
    sync /
    # A file still open for writing keeps the mount writable until the next start, which is read-only.
    if mount -o remount,ro /; then
        blockdev --setro "$(root_device)"
    else
        echo "Warning: The rootfs is busy: it is read-only from the next start." >&2
    fi
}

toggle() {
    if status >/dev/null; then
        read_write
    else
        read_only
    fi
    status
}

fstype=$(findmnt -fn --output FSTYPE /)
if [[ $fstype != ext4 ]]; then
    echo "Unrecognized root filesystem type $fstype"
    exit 1
fi

case "${1:-}" in
disable) action=read_write ;;
enable) action=read_only ;;
toggle) action=toggle ;;
status) action=status ;;
*)
    usage
    exit 1
    ;;
esac

"$action"
