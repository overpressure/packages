+/*
+ * The remote heap a static process gets, as PICO OS's kernel gives it.
+ */
+#define STATIC_PD_HEAP 0x200000
+
+/*
+ * Start a static process from the DSP's image (such as audiopd) on the
+ * upstream driver. The driver backs it with its remote heap, which it hands to
+ * the DSP's VMs (qcom,vmids).
+ */
+static int create_static_pd(int fd, const char *name)
+{
+	struct fastrpc_init_create_static init = {
+		.namelen = strlen(name) + 1,
+		.memlen = STATIC_PD_HEAP,
+		.name = (__u64) (uintptr_t) name,
+	};
+
+	return ioctl(fd, FASTRPC_IOCTL_INIT_CREATE_STATIC, &init);
+}
