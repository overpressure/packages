#!/bin/sh
# SPDX-License-Identifier: Unlicense
# The stock system's persist partition, read-only at /mnt/vendor/persist, where Android mounts it
# (a headset's docs/userspace.md): the headset's factory data that the image links to
# instead of shipping it: the sensor registry with its calibration, the camera, IMU and lens
# calibration (pvr/), the serial number the fan's batch comes from and the Wi-Fi MAC addresses.
# noload: an ext4 journal is never replayed, nothing is written; the block device stays
# read-only (the storage policy, overpressure-storage-ro.service).
set -eu
dir=/mnt/vendor/persist
mountpoint -q "$dir" && exit 0
# /mnt is SteamOS's link to /var/mnt, which lives on the data partition: an installed system keeps
# its /var from its first boot, and SteamOS's tmpfiles entry makes /var/mnt only after this runs.
mkdir -p "$(readlink -f /mnt)" "$dir"
dev=$(readlink -f /dev/block/by-name/persist 2>/dev/null || true)
[ -n "$dev" ] && [ -b "$dev" ] || { echo "persist: no partition named persist" >&2; exit 1; }
blockdev --setro "$dev"
mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$dev" "$dir"
echo "persist: $dev read-only at $dir"
